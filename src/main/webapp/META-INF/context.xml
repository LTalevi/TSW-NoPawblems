<?xml version="1.0" encoding="UTF-8"?>
<Context>
    <Resource name="jdbc/db_no_pawblems"
              auth="Container"
              type="javax.sql.DataSource"
              driverClassName="com.mysql.cj.jdbc.Driver"
              url="jdbc:mysql://localhost:3306/db_no_pawblems?serverTimezone=UTC&amp;useSSL=true"
              username="${db.user}"
              password="${db.pass}"
              maxTotal="20"
              maxIdle="10"
              maxWaitMillis="-1"/>
</Context>